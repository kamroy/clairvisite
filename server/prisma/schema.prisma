generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  acheteur
  technicien
  admin
}

enum AuthProvider {
  google
  password
}

enum TechnicianStatus {
  pending
  approved
  rejected
}

// Catégorie métier principale, utilisée pour le filtre de recherche par profil
// (Contre-visite Technique / Décoration d'intérieur / Architecture & Rénovation).
// Distincte de `specialties` (tags libres, plus fins) sur le modèle Technician.
enum TechnicianCategory {
  technique
  decoration
  architecture
}

enum BookingStatus {
  confirmed
  cancelled
}

// Type de bien concerné par la contre-visite — collecté à l'étape 1 du tunnel de
// réservation (voir docs/specs/03-reservation-et-projets.md, US-BOOK-01).
enum PropertyType {
  apartment
  house
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String?      @map("password_hash")
  authProvider AuthProvider @default(password) @map("auth_provider")
  oidcSubject  String?      @map("oidc_subject")
  role         Role
  fullName     String       @map("full_name")
  phone        String?
  avatarUrl    String?      @map("avatar_url")
  createdAt    DateTime     @default(now()) @map("created_at")

  emailVerifiedAt                 DateTime? @map("email_verified_at")
  emailVerificationTokenHash      String?   @map("email_verification_token_hash")
  emailVerificationTokenExpiresAt DateTime? @map("email_verification_token_expires_at")

  passwordResetTokenHash      String?   @map("password_reset_token_hash")
  passwordResetTokenExpiresAt DateTime? @map("password_reset_token_expires_at")

  // Pertinent uniquement pour role = admin (US-ADMIN-01) : rôle RBAC fin, distinct du
  // champ `role` grossier qui ne fait que distinguer acheteur/technicien/admin. Un
  // admin sans adminRoleId (comptes créés avant cette fonctionnalité) est traité comme
  // Super Admin par la couche application, pour ne rien casser rétroactivement.
  adminRoleId String?    @map("admin_role_id")
  adminRole   AdminRole? @relation(fields: [adminRoleId], references: [id])

  technician    Technician?
  bookings      Booking[]
  messages      Message[]
  notifications Notification[]

  @@unique([authProvider, oidcSubject])
  @@map("users")
}

// Rôle RBAC pour les comptes admin (US-ADMIN-01) : un ensemble nommé de permissions
// activables individuellement, assignable à plusieurs utilisateurs. `isSystem` protège
// le rôle "Super Admin" auto-créé (voir ListAdminRolesUseCase) contre le renommage, la
// suppression ou une modification de permissions qui pourrait verrouiller tout accès
// admin par erreur.
model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[]
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("admin_roles")
}

// Journal d'audit des actions de gestion des rôles/permissions admin (US-ADMIN-01) —
// périmètre volontairement restreint aux actions RBAC elles-mêmes (création/édition/
// clonage/suppression de rôle, assignation d'un admin) : les autres actions admin déjà
// existantes (validation technicien, etc.) ne sont pas encore journalisées ici.
model AdminAuditLogEntry {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actorName  String   @map("actor_name")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("admin_audit_log_entries")
}

model Technician {
  id          String           @id @default(uuid())
  userId      String           @unique @map("user_id")
  user        User             @relation(fields: [userId], references: [id])
  phone       String
  specialties String[]
  regions     String[]
  hourlyRate  Decimal?         @map("hourly_rate")
  status      TechnicianStatus @default(pending)
  bio         String?
  category    TechnicianCategory @default(technique)
  companyName String?          @map("company_name")
  siret       String?
  yearsOfExperience Int?       @map("years_of_experience")

  availabilities Availability[]
  documents      TechnicianDocument[]
  pricingItems   TechnicianPricingItem[]
  portfolioItems TechnicianPortfolioItem[]

  @@map("technicians")
}

// Pièces justificatives déposées pendant l'inscription pro (assurance RC pro, pièce
// d'identité, diplômes...) — le fichier lui-même vit dans le stockage objet (voir
// src/infrastructure/storage/), cette table ne garde que la référence.
model TechnicianDocument {
  id           String     @id @default(uuid())
  technicianId String     @map("technician_id")
  technician   Technician @relation(fields: [technicianId], references: [id])
  key          String
  fileName     String     @map("file_name")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("technician_documents")
}

// Grille tarifaire publique par prestation (ex. "Conseil Décor Complète — 250€"),
// distincte du `hourlyRate` indicatif — affichée sur le profil public.
model TechnicianPricingItem {
  id           String     @id @default(uuid())
  technicianId String     @map("technician_id")
  technician   Technician @relation(fields: [technicianId], references: [id])
  label        String
  price        Decimal
  position     Int        @default(0)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("technician_pricing_items")
}

// Galerie de réalisations affichée sur le profil public — le fichier vit dans le
// stockage objet, cette table ne garde que la référence (même principe que
// TechnicianDocument, mais visible publiquement plutôt que réservé à l'admin).
model TechnicianPortfolioItem {
  id           String     @id @default(uuid())
  technicianId String     @map("technician_id")
  technician   Technician @relation(fields: [technicianId], references: [id])
  key          String
  caption      String?
  position     Int        @default(0)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("technician_portfolio_items")
}

model Availability {
  id            String     @id @default(uuid())
  technicianId  String     @map("technician_id")
  technician    Technician @relation(fields: [technicianId], references: [id])
  startDatetime DateTime   @map("start_datetime")
  endDatetime   DateTime   @map("end_datetime")
  isBooked      Boolean    @default(false) @map("is_booked")

  booking Booking?

  @@map("availabilities")
}

model Booking {
  id              String        @id @default(uuid())
  availabilityId  String        @unique @map("availability_id")
  availability    Availability  @relation(fields: [availabilityId], references: [id])
  buyerId         String        @map("buyer_id")
  buyer           User          @relation(fields: [buyerId], references: [id])
  buyerPhone      String        @map("buyer_phone")
  propertyAddress String        @map("property_address")
  propertyType    PropertyType? @map("property_type")
  surfaceM2       Int?          @map("surface_m2")
  // Renseignés uniquement pour une consultation déco (US-BOOK-03) — le technicien
  // concerné a `category: decoration` ; laissés vides pour une contre-visite technique.
  roomsConcerned     String[] @map("rooms_concerned")
  projectDescription String?  @map("project_description")
  status          BookingStatus @default(confirmed)
  createdAt       DateTime      @default(now()) @map("created_at")

  technicalReport TechnicalReport?
  conversation    Conversation?

  @@map("bookings")
}

// Une conversation par réservation (US-COMM-01) : l'interlocuteur (acheteur <->
// technicien) est déjà déterminé par la réservation, pas besoin d'un modèle de
// participants séparé. Créée paresseusement au premier accès (même schéma que
// TechnicalReport), pas à la création de la réservation.
model Conversation {
  id        String   @id @default(uuid())
  bookingId String   @unique @map("booking_id")
  booking   Booking  @relation(fields: [bookingId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String       @map("sender_id")
  sender         User         @relation(fields: [senderId], references: [id])
  // L'un des deux au moins est renseigné : texte seul, pièce jointe seule, ou les deux.
  content            String?
  attachmentKey      String?  @map("attachment_key")
  attachmentFileName String?  @map("attachment_file_name")
  createdAt          DateTime @default(now()) @map("created_at")
  readAt             DateTime? @map("read_at")

  @@map("messages")
}

enum ReportStatus {
  draft
  submitted
}

// Sections prédéfinies (US-REPORT-01) — "Systèmes Techniques" du prototype est éclaté
// en une section par système (electricity/plumbing/heating) plutôt qu'une section
// unique, pour que chacun porte son propre statut de gravité (voir SystemStatus),
// nécessaire au tableau de synthèse par système de US-REPORT-02.
enum ReportSectionType {
  introduction
  structure
  electricity
  plumbing
  heating
}

// Statut de gravité par système, alimente à la fois le tableau de synthèse et la liste
// "Points d'Attention Prioritaires" (dérivée des sections non "good", pas d'entité dédiée).
enum SystemStatus {
  good
  medium
  critical
}

enum PhotoRole {
  before
  after
}

// Rapport technique rédigé par l'expert et consulté par l'acheteur (US-REPORT-01/02).
// Un seul rapport par réservation (relation 1:1).
model TechnicalReport {
  id                String       @id @default(uuid())
  bookingId         String       @unique @map("booking_id")
  booking           Booking      @relation(fields: [bookingId], references: [id])
  status            ReportStatus @default(draft)
  // "Conclusion Générale" affichée en encadré en tête de la vue acheteur.
  generalConclusion String?      @map("general_conclusion")
  submittedAt       DateTime?    @map("submitted_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  sections ReportSection[]

  @@map("technical_reports")
}

model ReportSection {
  id          String            @id @default(uuid())
  reportId    String            @map("report_id")
  report      TechnicalReport   @relation(fields: [reportId], references: [id])
  sectionType ReportSectionType @map("section_type")
  // Texte enrichi limité à **gras** / _italique_ (markdown minimal, jamais de HTML brut
  // stocké ni rendu — voir client/src/lib/richText.js) : évite d'introduire une
  // dépendance éditeur WYSIWYG pour un besoin aussi restreint, sans risque XSS.
  content String?
  // Uniquement pertinent pour les sections "système" (electricity/plumbing/heating) ;
  // null pour introduction/structure (sections narratives sans statut de gravité).
  status SystemStatus?

  photos ReportPhoto[]

  @@unique([reportId, sectionType])
  @@map("report_sections")
}

// Photos par section (avant/après optionnel via `role`) — sert aussi de "documents
// annexes téléchargeables" (US-REPORT-02) : chaque photo est individuellement
// téléchargeable via une URL pré-signée, pas de type de document séparé.
model ReportPhoto {
  id        String        @id @default(uuid())
  sectionId String        @map("section_id")
  section   ReportSection @relation(fields: [sectionId], references: [id])
  key       String
  caption   String?
  role      PhotoRole?
  position  Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("report_photos")
}

model Region {
  id   String @id @default(uuid())
  name String @unique

  @@map("regions")
}

// Catégories du centre de notifications (US-COMM-02), reprises telles quelles du
// prototype Stitch. "devis_finances" et "compte_profil" n'ont pour l'instant aucun
// producteur (pas de module paiement/document) : la taxonomie existe déjà côté filtre,
// prête à être alimentée quand ces modules existeront.
enum NotificationCategory {
  visite_technique
  decoration
  devis_finances
  compte_profil
}

// Notification in-app générée par d'autres modules (booking/report/messaging) via le
// port NOTIFICATION_PUBLISHER — table de lecture simple, pas de canal temps réel
// (même choix polling que la messagerie, voir 06-communication.md).
model Notification {
  id        String               @id @default(uuid())
  userId    String               @map("user_id")
  user      User                 @relation(fields: [userId], references: [id])
  category  NotificationCategory
  title     String
  body      String?
  ctaLabel  String?              @map("cta_label")
  ctaUrl    String?              @map("cta_url")
  isRead    Boolean              @default(false) @map("is_read")
  createdAt DateTime             @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}
