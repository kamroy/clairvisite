# Copiez ce fichier en .env à la racine avant `docker compose up`.
# Ce fichier alimente uniquement docker-compose.yml — les .env de server/ et client/
# ne sont pas utilisés en mode Docker Compose (les variables sont injectées directement
# dans les services via docker-compose.yml).

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=clairvisite

JWT_SECRET=change-me-in-your-local-env

# Compte admin créé automatiquement par le seed au démarrage — changez le mot de
# passe si ce .env sert ailleurs qu'en local.
ADMIN_SEED_EMAIL=admin@clairvisite.fr
ADMIN_SEED_PASSWORD=ChangeMoi123!


# Optionnel : laissez vide pour désactiver la connexion Google en local (le
# formulaire email/mot de passe reste utilisable).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optionnel : sans clé Resend réelle, l'application démarre normalement mais les
# emails (vérification de compte, confirmation de réservation) ne partent pas.
RESEND_API_KEY=

# Stockage fichiers (MinIO en local, S3-compatible). Ces identifiants servent à la
# fois à démarrer le conteneur MinIO (MINIO_ROOT_USER/PASSWORD) et à l'app pour s'y
# connecter — à ne jamais réutiliser tels quels en production.
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin123
